# Application
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://vibe_admin:vibe_admin_password_change_me@localhost:5432/vibe_platform

# Hasura
HASURA_GRAPHQL_URL=http://localhost:8080
HASURA_ADMIN_SECRET=your_admin_secret_change_me

# JWT
JWT_SECRET=your_jwt_secret_change_me_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# AI Safety
AI_SCHEMA_CHANGE_ENABLED=true
AI_MAX_FIELDS_PER_ENTITY=50
AI_MAX_ENTITIES_PER_PROJECT=100

# Logging
LOG_LEVEL=INFO
